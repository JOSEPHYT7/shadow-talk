# Environment variables & secrets (CRITICAL: Do not commit)
.env
.env.*
*.env
!.env.example

# Node.js dependencies
node_modules/

# Uploaded files (preserve folder structure via .gitkeep)
uploads/*
!uploads/.gitkeep

# Runtime session keys, admin sessions, and maintenance states
data/.session_secret
data/.cli_secret
data/admin_sessions.json
data/maintenance_config.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
