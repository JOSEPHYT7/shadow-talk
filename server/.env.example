PORT=5000

# Gmail SMTP Configuration for Real Email OTP Sending
# 1. EMAIL_USER: Your Gmail address (e.g. yourname@gmail.com)
# 2. EMAIL_APP_PASSWORD: 16-character App Password generated at https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_char_app_password

# ==========================================================
# James AI — Autonomous Community Agent Configuration
# ==========================================================
# Primary AI Provider: 'openrouter' (default), 'openai', 'gemini', or 'fallback'
AI_PROVIDER=openrouter

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key

# Configurable model for James (supports any OpenRouter / OpenAI / Gemini model)
# Popular choices:
# - 'google/gemini-2.5-flash'
# - 'openai/gpt-4o-mini'
# - 'anthropic/claude-3.5-haiku'
# - 'meta-llama/llama-3.3-70b-instruct:free'
JAMES_MODEL=google/gemini-2.5-flash

# Optional Alternative Direct Providers:
# OPENAI_API_KEY=your_openai_api_key
# GEMINI_API_KEY=your_gemini_api_key

# Optional Search API Key (Defaults to DuckDuckGo zero-key search if omitted):
# TAVILY_API_KEY=your_tavily_key
# SERPER_API_KEY=your_serper_key

# Optional 24/7 Cloud Keep-Alive Pulse URL
# KEEP_ALIVE_URL=https://shadow-talk-kryk.onrender.com/health
